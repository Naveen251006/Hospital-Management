# Hospital Management System Environment Configuration
SECRET_KEY=hospital-management-secret-key-super-secure-2026
# Set to 'false' to use MySQL, or 'true' to use SQLite directly
USE_SQLITE=auto

# MySQL Database Settings (hospital_db)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=hospital_db

# Or direct DATABASE_URL override:
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/hospital_db
